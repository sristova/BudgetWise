# ─────────────────────────────────────────────
# BudgetWise Frontend — okoljske spremenljivke
# Skopiraj to datoteko v `.env` in nastavi svoje vrednosti:
#   cp .env.example .env
# ─────────────────────────────────────────────

# Osnovni URL backend API-ja.
# Zamenjaj z lokalnim IP naslovom računalnika (ipconfig / ifconfig)
# ali z URL-jem produkcijskega strežnika.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api/v1

# Google OAuth Client ID-ji (za prijavo z Google računom)
# Pridobiš jih v Google Cloud Console za vsako platformo posebej.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=xxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=xxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=xxxxxxxxxxxx.apps.googleusercontent.com
